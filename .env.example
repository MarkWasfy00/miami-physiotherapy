# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://miamiclinic.net

# Where new bookings are POSTed as JSON (Zapier / Make / n8n → Google Sheets, email, WhatsApp…).
# Required on Vercel: the serverless filesystem is ephemeral, so this is the only durable copy.
BOOKING_WEBHOOK_URL=

# Optional: override the local bookings file (defaults to ./data/bookings.json, or the temp dir on Vercel).
# BOOKINGS_FILE=
